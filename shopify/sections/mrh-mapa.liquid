{%- comment -%}
  ═══════════════════════════════════════════════════════════════
  MANDARINA REPUBLIC — MAPA INTERACTIVO (tienda navegable)

  Mundo top-down en pixel art: cada edificio es una colección.
  Todo el arte se dibuja por código (canvas), cero imágenes que
  descargar y cero assets de terceros.

  La sección es AUTOCONTENIDA: trae sus propios tokens, estilos y
  script. No depende de mrh.css ni de mrh.js, así que se puede
  probar en un tema viejo y luego mover al tema live tal cual.

  Accesible por diseño: los nombres de los edificios y los chips
  son <a> reales (teclado, lector de pantalla y Google los ven
  aunque el canvas no llegue a dibujarse).
  ═══════════════════════════════════════════════════════════════
{%- endcomment -%}

{%- liquid
  assign wa = section.settings.whatsapp | remove: ' ' | remove: '+' | remove: '-'
  assign wa_txt = section.settings.wa_text | url_encode
-%}

{%- capture zonas_json -%}
[
{%- for block in section.blocks -%}
  {%- assign col = collections[block.settings.collection] -%}
  {%- assign nom = block.settings.title | default: col.title | default: 'Universo' -%}
  {
    "name": {{ nom | json }},
    "color": {{ block.settings.color | default: '#FF5E0E' | json }},
    "eyebrow": {{ block.settings.eyebrow | json }},
    "text": {{ block.settings.text | json }},
    "url": {% if col != blank %}{{ col.url | json }}{% else %}"/collections/all"{% endif %},
    "count": {% if col != blank %}{{ col.all_products_count }}{% else %}0{% endif %},
    "items": [
      {%- if col != blank -%}
        {%- for p in col.products limit: 4 -%}
          {
            "t": {{ p.title | json }},
            "u": {{ p.url | json }},
            "p": {{ p.price | money | json }},
            "i": {% if p.featured_image != blank %}{{ p.featured_image | image_url: width: 240 | json }}{% else %}""{% endif %}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      {%- endif -%}
    ]
  }{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
{%- endcapture -%}

{%- if section.settings.load_fonts -%}
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo:wght@400;600;700&family=Space+Mono:wght@400;700&display=swap">
{%- endif -%}

{{ 'mrh-mapa.css' | asset_url | stylesheet_tag }}
<script src="{{ 'mrh-mapa.js' | asset_url }}" defer></script>

<section class="mrmap-sec" id="mrmap-{{ section.id }}"
         data-wa="{{ wa }}"
         data-watext="{{ wa_txt }}"
         data-tienda="{{ section.settings.map }}"
         data-tienda-nombre="{{ section.settings.store_title | escape }}"
         data-tienda-txt="{{ section.settings.store_text | escape }}"
         data-promo="{% if section.settings.promo_on and section.settings.promo_code != blank %}1{% endif %}"
         data-promo-code="{{ section.settings.promo_code | escape }}"
         data-promo-title="{{ section.settings.promo_title | escape }}"
         data-promo-text="{{ section.settings.promo_text | escape }}"
         data-promo-cta="{{ section.settings.promo_cta | escape }}"
         data-promo-url="{% if section.settings.promo_url != blank %}{{ section.settings.promo_url }}{% else %}/discount/{{ section.settings.promo_code | url_encode }}?redirect=/collections/all{% endif %}"
         data-promo-suelta="{{ section.settings.promo_loose | escape }}"
         data-promo-espera="{{ section.settings.promo_wait | escape }}"
         data-promo-respawn="{{ section.settings.promo_respawn }}">

  <div class="mrmap-wrap">
    <header class="mrmap-head">
      <span class="mrmap-eye">{{ section.settings.eyebrow }}</span>
      <h2 class="mrmap-h2">{{ section.settings.title }}</h2>
      <p class="mrmap-sub">{{ section.settings.text }}</p>
    </header>

    <div class="mrmap">
      <div class="mrmap__stage" tabindex="0" aria-label="Mapa jugable. Toca o enfoca y camina con las flechas.">
        <canvas class="mrmap__cv" width="320" height="200" role="img"
                aria-label="Mapa de Mandarina Republic en pixel art. La lista de universos que está debajo lleva a cada colección."></canvas>

        <div class="mrmap__tags"></div>

        <p class="mrmap__hint">Toca el mapa · <b>← ↑ ↓ →</b> caminar · <b>E</b> entrar</p>

        <p class="mrmap__promo" hidden></p>

        <div class="mrmap__pad" aria-hidden="true">
          <div class="mrmap__dpad">
            <button type="button" class="mrmap__d mrmap__d--u" data-dir="u" tabindex="-1"></button>
            <button type="button" class="mrmap__d mrmap__d--l" data-dir="l" tabindex="-1"></button>
            <button type="button" class="mrmap__d mrmap__d--r" data-dir="r" tabindex="-1"></button>
            <button type="button" class="mrmap__d mrmap__d--d" data-dir="d" tabindex="-1"></button>
          </div>
          <button type="button" class="mrmap__a" data-act="1" tabindex="-1">E</button>
        </div>

        <div class="mrmap__dlg" hidden role="dialog" aria-modal="true" aria-labelledby="mrmap-dt-{{ section.id }}">
          <button type="button" class="mrmap__x" aria-label="Cerrar">✕</button>
          <span class="mrmap-eye mrmap__dlgeye"></span>
          <h3 class="mrmap__dlgt" id="mrmap-dt-{{ section.id }}"></h3>
          <p class="mrmap__dlgp"></p>
          <div class="mrmap__thumbs"></div>
          <div class="mrmap__code" hidden>
            <b></b>
            <button type="button" class="mrmap__copy">Copiar</button>
          </div>
          <a class="mrmap__cta" href="/collections/all">Entrar</a>
        </div>
      </div>

      <nav class="mrmap__rail" aria-label="Universos del mapa">
        {%- for block in section.blocks -%}
          {%- assign col = collections[block.settings.collection] -%}
          <a class="mrmap__chip"
             href="{% if col != blank %}{{ col.url }}{% else %}/collections/all{% endif %}"
             data-zona="{{ forloop.index0 }}"
             style="--chip: {{ block.settings.color | default: '#FF5E0E' }};"
             {{ block.shopify_attributes }}>
            {{ block.settings.title | default: col.title | default: 'Universo' }}
          </a>
        {%- endfor -%}
        <a class="mrmap__chip mrmap__chip--all" href="/collections/all">🍊 Ver todo</a>
      </nav>
    </div>
  </div>

  <script type="application/json" class="mrmap__data">{{ zonas_json | replace: '</script', '<\/script' }}</script>
</section>

{% schema %}
{
  "name": "MR · Mapa interactivo",
  "tag": "section",
  "class": "mrh-section mrmap-host",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Antetítulo", "default": "Explora el mundo Mandarina" },
    { "type": "text", "id": "title", "label": "Título", "default": "Mandarina World" },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Camina por el mapa y entra a cada universo. Toca el mapa y muévete con las flechas — o usa los atajos de abajo." },
    { "type": "checkbox", "id": "load_fonts", "label": "Cargar tipografías (Anton / Archivo / Space Mono)", "info": "Déjalo activo en temas donde la sección viva sola. Apágalo si el tema ya carga estas fuentes.", "default": true },
    { "type": "header", "content": "Personaje del taller (WhatsApp)" },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp (con código de país)", "default": "593983745757" },
    { "type": "text", "id": "wa_text", "label": "Mensaje precargado", "default": "Hola Mandarina! Quiero un diseño personalizado 🎨" },
    { "type": "header", "content": "Personaje de la tienda física" },
    { "type": "text", "id": "store_title", "label": "Título", "default": "Visítanos en Quito" },
    { "type": "textarea", "id": "store_text", "label": "Texto", "default": "Av. 6 de Diciembre y Mercurio, Quito. Lunes a sábado de 10h30 a 18h00. Envío GRATIS a todo el Ecuador." },
    { "type": "url", "id": "map", "label": "Link del mapa" },
    { "type": "header", "content": "Mandarina salvaje (promo)" },
    { "type": "paragraph", "content": "Suelta una mandarina por el mapa. Huye cuando te acercas; si la alcanzas, suelta el código." },
    { "type": "checkbox", "id": "promo_on", "label": "Soltar la mandarina salvaje", "default": true },
    { "type": "text", "id": "promo_code", "label": "Código de descuento", "info": "Tiene que ser un código que ya exista y esté activo en Descuentos.", "default": "MANDARINA10" },
    { "type": "text", "id": "promo_title", "label": "Título al atraparla", "default": "¡La atrapaste!" },
    { "type": "textarea", "id": "promo_text", "label": "Texto al atraparla", "default": "Se te escapaba por poco. Llévate el descuento con este código — se aplica solo al pasar por el botón." },
    { "type": "text", "id": "promo_cta", "label": "Texto del botón", "default": "Usar el descuento →" },
    { "type": "url", "id": "promo_url", "label": "A dónde lleva el botón", "info": "Si lo dejas vacío va al catálogo con el código ya aplicado." },
    { "type": "text", "id": "promo_loose", "label": "Aviso mientras anda suelta", "default": "🍊 Hay una mandarina suelta — atrápala" },
    { "type": "text", "id": "promo_wait", "label": "Aviso mientras no está", "default": "🍊 Se escondió… vuelve en un rato" },
    { "type": "range", "id": "promo_respawn", "label": "Vuelve a salir a los", "unit": "s", "min": 5, "max": 60, "step": 5, "default": 20 }
  ],
  "blocks": [
    {
      "type": "zona",
      "name": "Zona (edificio)",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Colección" },
        { "type": "text", "id": "title", "label": "Nombre en el mapa", "info": "Si lo dejas vacío usa el nombre de la colección." },
        { "type": "color", "id": "color", "label": "Color del techo", "default": "#FF5E0E" },
        { "type": "text", "id": "eyebrow", "label": "Antetítulo del diálogo", "default": "Universo" },
        { "type": "textarea", "id": "text", "label": "Texto del diálogo" }
      ]
    }
  ],
  "presets": [
    {
      "name": "MR · Mapa interactivo",
      "blocks": [
        { "type": "zona", "settings": { "title": "Dragon Ball",    "color": "#FF7A29", "eyebrow": "Universo · energía Saiyan",       "text": "Sube tu poder al máximo. Goku, Vegeta y toda la saga en chaquetas full color." } },
        { "type": "zona", "settings": { "title": "Power Rangers",  "color": "#EC3B8B", "eyebrow": "Universo · es hora de la morfosis","text": "Rojo, Rosa, Azul, Amarillo, Negro y Blanco. Elige tu Ranger." } },
        { "type": "zona", "settings": { "title": "One Piece",      "color": "#2E9BE8", "eyebrow": "Universo · rumbo al One Piece",   "text": "Iza las velas con los Sombrero de Paja. Luffy, Zoro, Sanji y Chopper." } },
        { "type": "zona", "settings": { "title": "Pokémon",        "color": "#FFC400", "eyebrow": "Universo · hazte con todas",      "text": "Charizard, Bulbasaur, Gengar y Squirtle en chaquetas de colección." } },
        { "type": "zona", "settings": { "title": "Tortugas Ninja", "color": "#4CC23A", "eyebrow": "Universo · héroes en media concha","text": "Pizza, alcantarillas y artes marciales. Leo, Rafa, Mikey y Donnie." } },
        { "type": "zona", "settings": { "title": "Spider-Man",     "color": "#E5342B", "eyebrow": "Universo · el vecino amigable",   "text": "Del multiverso a tu clóset. Rojo y azul a tope de contraste." } },
        { "type": "zona", "settings": { "title": "X-Men",          "color": "#4DA3FF", "eyebrow": "Universo · mutantes",             "text": "Wolverine, Gambito, Cíclope y Storm. La escuela de Xavier en hoodie." } },
        { "type": "zona", "settings": { "title": "Lo más vendido", "color": "#FF5E0E", "eyebrow": "Catálogo · lo que más sale",      "text": "Los diseños que más vuelan. Si dudas, empieza por aquí." } }
      ]
    }
  ]
}
{% endschema %}
