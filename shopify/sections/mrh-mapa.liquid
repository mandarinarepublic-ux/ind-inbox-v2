{%- comment -%}
  ═══════════════════════════════════════════════════════════════
  MANDARINA REPUBLIC — MAPA INTERACTIVO (tienda navegable)

  Mundo top-down en pixel art: cada edificio es una colección.
  Todo el arte se dibuja por código (canvas), cero imágenes que
  descargar y cero assets de terceros.

  La sección es AUTOCONTENIDA: trae sus propios tokens, estilos y
  script. No depende de mrh.css ni de mrh.js, así que se puede
  probar en un tema viejo y luego mover al tema live tal cual.

  Accesible por diseño: los nombres de los edificios y los chips
  son <a> reales (teclado, lector de pantalla y Google los ven
  aunque el canvas no llegue a dibujarse).
  ═══════════════════════════════════════════════════════════════
{%- endcomment -%}

{%- liquid
  assign wa = section.settings.whatsapp | remove: ' ' | remove: '+' | remove: '-'
  assign wa_txt = section.settings.wa_text | url_encode
-%}

{%- capture zonas_json -%}
[
{%- for block in section.blocks -%}
  {%- assign col = collections[block.settings.collection] -%}
  {%- assign nom = block.settings.title | default: col.title | default: 'Universo' -%}
  {
    "name": {{ nom | json }},
    "color": {{ block.settings.color | default: '#FF5E0E' | json }},
    "eyebrow": {{ block.settings.eyebrow | json }},
    "text": {{ block.settings.text | json }},
    "url": {% if col != blank %}{{ col.url | json }}{% else %}"/collections/all"{% endif %},
    "count": {% if col != blank %}{{ col.all_products_count }}{% else %}0{% endif %},
    "items": [
      {%- if col != blank -%}
        {%- for p in col.products limit: 4 -%}
          {
            "t": {{ p.title | json }},
            "u": {{ p.url | json }},
            "p": {{ p.price | money | json }},
            "i": {% if p.featured_image != blank %}{{ p.featured_image | image_url: width: 240 | json }}{% else %}""{% endif %}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      {%- endif -%}
    ]
  }{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
{%- endcapture -%}

{%- if section.settings.load_fonts -%}
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=Archivo:wght@400;600;700&family=Space+Mono:wght@400;700&display=swap">
{%- endif -%}

<section class="mrmap-sec" id="mrmap-{{ section.id }}"
         data-wa="{{ wa }}"
         data-watext="{{ wa_txt }}"
         data-tienda="{{ section.settings.map }}"
         data-tienda-nombre="{{ section.settings.store_title | escape }}"
         data-tienda-txt="{{ section.settings.store_text | escape }}">

  <div class="mrmap-wrap">
    <header class="mrmap-head">
      <span class="mrmap-eye">{{ section.settings.eyebrow }}</span>
      <h2 class="mrmap-h2">{{ section.settings.title }}</h2>
      <p class="mrmap-sub">{{ section.settings.text }}</p>
    </header>

    <div class="mrmap">
      <div class="mrmap__stage" tabindex="0" aria-label="Mapa jugable. Toca o enfoca y camina con las flechas.">
        <canvas class="mrmap__cv" width="320" height="200" role="img"
                aria-label="Mapa de Mandarina Republic en pixel art. La lista de universos que está debajo lleva a cada colección."></canvas>

        <div class="mrmap__tags"></div>

        <p class="mrmap__hint">Toca el mapa · <b>← ↑ ↓ →</b> caminar · <b>E</b> entrar</p>

        <div class="mrmap__pad" aria-hidden="true">
          <div class="mrmap__dpad">
            <button type="button" class="mrmap__d mrmap__d--u" data-dir="u" tabindex="-1"></button>
            <button type="button" class="mrmap__d mrmap__d--l" data-dir="l" tabindex="-1"></button>
            <button type="button" class="mrmap__d mrmap__d--r" data-dir="r" tabindex="-1"></button>
            <button type="button" class="mrmap__d mrmap__d--d" data-dir="d" tabindex="-1"></button>
          </div>
          <button type="button" class="mrmap__a" data-act="1" tabindex="-1">E</button>
        </div>

        <div class="mrmap__dlg" hidden role="dialog" aria-modal="true" aria-labelledby="mrmap-dt-{{ section.id }}">
          <button type="button" class="mrmap__x" aria-label="Cerrar">✕</button>
          <span class="mrmap-eye mrmap__dlgeye"></span>
          <h3 class="mrmap__dlgt" id="mrmap-dt-{{ section.id }}"></h3>
          <p class="mrmap__dlgp"></p>
          <div class="mrmap__thumbs"></div>
          <a class="mrmap__cta" href="/collections/all">Entrar</a>
        </div>
      </div>

      <nav class="mrmap__rail" aria-label="Universos del mapa">
        {%- for block in section.blocks -%}
          {%- assign col = collections[block.settings.collection] -%}
          <a class="mrmap__chip"
             href="{% if col != blank %}{{ col.url }}{% else %}/collections/all{% endif %}"
             data-zona="{{ forloop.index0 }}"
             style="--chip: {{ block.settings.color | default: '#FF5E0E' }};"
             {{ block.shopify_attributes }}>
            {{ block.settings.title | default: col.title | default: 'Universo' }}
          </a>
        {%- endfor -%}
        <a class="mrmap__chip mrmap__chip--all" href="/collections/all">🍊 Ver todo</a>
      </nav>
    </div>
  </div>

  <script type="application/json" class="mrmap__data">{{ zonas_json | replace: '</script', '<\/script' }}</script>
</section>

<style>
  /* ── tokens locales: la sección no depende de mrh.css ── */
  .mrmap-sec {
    --mr: #FF5E0E; --mr-400: #FF7A29;
    --ink: #0F0B07; --ink-2: #181208; --ink-3: #2B2218;
    --paper: #FFF8F2; --mute: #B3A597; --mute-2: #8A7C6E;
    --zest: #FFC400; --wa: #25D366;
    --bd: rgba(255,248,242,.14);
    --dsp: 'Anton', Impact, 'Arial Narrow', sans-serif;
    --body: 'Archivo', system-ui, -apple-system, sans-serif;
    --mono: 'Space Mono', ui-monospace, monospace;
    --pad: 18px;
    display: block; position: relative;
    background: radial-gradient(120% 80% at 50% 0%, rgba(255,94,14,.16), transparent 60%), var(--ink);
    color: var(--paper); font-family: var(--body);
    padding: 44px 0 52px;
    -webkit-font-smoothing: antialiased;
  }
  .mrmap-sec *, .mrmap-sec *::before, .mrmap-sec *::after { box-sizing: border-box; }
  .mrmap-sec a { color: inherit; text-decoration: none; }
  .mrmap-sec :where(button) { font: inherit; color: inherit; background: none; border: 0; cursor: pointer; }
  .mrmap-sec p, .mrmap-sec h2, .mrmap-sec h3 { margin: 0; letter-spacing: normal; color: inherit; }
  .mrmap-wrap { max-width: 1280px; margin: 0 auto; padding-inline: var(--pad); }

  .mrmap-head { display: flex; flex-direction: column; gap: 10px; margin-bottom: 20px; }
  .mrmap-eye { font-family: var(--mono); font-weight: 700; font-size: 11px; letter-spacing: .16em; text-transform: uppercase; color: var(--accent, var(--mr)); display: block; }
  .mrmap-h2 { font-family: var(--dsp); font-weight: 400; text-transform: uppercase; font-size: clamp(34px, 9vw, 64px); line-height: .92; color: var(--paper); }
  .mrmap-sub { color: var(--mute); font-size: 15px; line-height: 1.55; max-width: 52ch; }

  /* ── escenario ── */
  .mrmap__stage {
    position: relative; width: 100%; aspect-ratio: 1 / 1;
    border: 3px solid var(--ink-3); border-radius: 14px; overflow: hidden;
    background: #4FA83E; box-shadow: 6px 6px 0 var(--ink-3);
    touch-action: manipulation; user-select: none; -webkit-user-select: none;
  }
  .mrmap__cv {
    display: block; width: 100%; height: 100%;
    image-rendering: pixelated; image-rendering: crisp-edges;
  }

  /* etiquetas HTML flotando sobre los edificios: texto real, nítido */
  .mrmap__tags { position: absolute; inset: 0; pointer-events: none; }
  .mrmap__tag {
    position: absolute; top: 0; left: 0; pointer-events: auto;
    transform: translate3d(-50%, -100%, 0); white-space: nowrap;
    font-family: var(--mono); font-weight: 700; font-size: 10px;
    letter-spacing: .06em; text-transform: uppercase; line-height: 1;
    padding: 5px 9px; border-radius: 999px;
    background: var(--ink); color: var(--paper);
    border: 2px solid var(--tagc, var(--mr));
    box-shadow: 0 3px 0 rgba(0,0,0,.45);
    transition: transform .12s ease;
  }
  .mrmap__tag:hover, .mrmap__tag:focus-visible { background: var(--tagc, var(--mr)); color: var(--ink); }
  .mrmap__tag.is-near { animation: mrmapPop .5s ease-in-out infinite alternate; }
  @keyframes mrmapPop { from { transform: translate3d(-50%,-100%,0); } to { transform: translate3d(-50%,-118%,0); } }

  .mrmap__hint {
    position: absolute; left: 10px; top: 10px; z-index: 3;
    font-family: var(--mono); font-size: 10px; letter-spacing: .06em; text-transform: uppercase;
    color: var(--paper); background: rgba(15,11,7,.72); border: 1px solid var(--bd);
    padding: 6px 10px; border-radius: 999px; pointer-events: none;
    transition: opacity .3s ease;
  }
  .mrmap__hint b { color: var(--zest); }
  .mrmap__hint.is-off { opacity: 0; }

  /* ── controles táctiles ── */
  .mrmap__pad { position: absolute; inset: auto 0 0 0; z-index: 4; display: none; align-items: flex-end; justify-content: space-between; padding: 8px; opacity: .88; }
  .mrmap__dpad { position: relative; width: 90px; height: 90px; }
  .mrmap__d {
    position: absolute; width: 30px; height: 30px; border-radius: 8px;
    background: rgba(15,11,7,.55); border: 2px solid rgba(255,248,242,.30);
  }
  .mrmap__d::after { content: ''; position: absolute; inset: 0; margin: auto; width: 0; height: 0; border: 5px solid transparent; }
  .mrmap__d--u { top: 0; left: 30px; } .mrmap__d--u::after { border-bottom-color: #FFF8F2; margin-top: 5px; }
  .mrmap__d--d { bottom: 0; left: 30px; } .mrmap__d--d::after { border-top-color: #FFF8F2; margin-bottom: 5px; }
  .mrmap__d--l { top: 30px; left: 0; } .mrmap__d--l::after { border-right-color: #FFF8F2; margin-left: 5px; }
  .mrmap__d--r { top: 30px; right: 0; } .mrmap__d--r::after { border-left-color: #FFF8F2; margin-right: 5px; }
  .mrmap__d:active { background: var(--mr); }
  .mrmap__a {
    width: 46px; height: 46px; border-radius: 50%; margin-bottom: 22px;
    background: var(--mr); color: var(--ink); border: 3px solid var(--ink);
    font-family: var(--dsp); font-size: 18px; line-height: 1;
    box-shadow: 0 3px 0 rgba(0,0,0,.5);
  }
  .mrmap__a:active { transform: translateY(3px); box-shadow: none; }
  @media (pointer: coarse) { .mrmap__pad { display: flex; } .mrmap__hint { display: none; } }

  /* ── caja de diálogo estilo RPG ── */
  .mrmap__dlg {
    position: absolute; z-index: 6; left: 10px; right: 10px; bottom: 10px;
    background: rgba(15,11,7,.97); border: 3px solid var(--accent, var(--mr));
    border-radius: 12px; padding: 14px 16px 16px;
    box-shadow: 0 -8px 30px rgba(0,0,0,.5);
    animation: mrmapUp .18s ease-out;
  }
  .mrmap__dlg[hidden] { display: none; }
  @keyframes mrmapUp { from { transform: translateY(12px); opacity: 0; } to { transform: none; opacity: 1; } }
  .mrmap__x { position: absolute; top: 8px; right: 8px; width: 30px; height: 30px; border-radius: 50%; border: 1px solid var(--bd); font-size: 14px; line-height: 1; }
  .mrmap__dlgt { font-family: var(--dsp); font-weight: 400; text-transform: uppercase; font-size: clamp(24px, 6vw, 38px); line-height: .95; color: var(--paper); margin: 4px 0 6px; }
  .mrmap__dlgp { font-size: 13px; line-height: 1.5; color: rgba(255,248,242,.76); max-width: 46ch; min-height: 2.6em; }
  .mrmap__dlgp .mrmap__cur { color: var(--accent, var(--mr)); }
  .mrmap__thumbs { display: flex; gap: 8px; margin: 12px 0 14px; }
  .mrmap__thumbs a { flex: 1 1 0; max-width: 84px; display: block; border: 2px solid var(--bd); border-radius: 8px; overflow: hidden; background: var(--ink-2); transition: border-color .14s ease, transform .14s ease; }
  .mrmap__thumbs a:hover { border-color: var(--accent, var(--mr)); transform: translateY(-3px); }
  .mrmap__thumbs img { display: block; width: 100%; aspect-ratio: 4/5; object-fit: cover; }
  .mrmap__thumbs b { display: block; font-family: var(--mono); font-size: 9px; padding: 4px 5px; color: var(--paper); }
  .mrmap__cta {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    font-weight: 700; font-size: 13px; letter-spacing: .03em; text-transform: uppercase;
    padding: 12px 22px; border-radius: 999px;
    background: var(--accent, var(--mr)); color: var(--ink);
    box-shadow: 4px 4px 0 #000; transition: transform .14s ease, box-shadow .14s ease;
  }
  .mrmap__cta:hover { transform: translateY(-2px); box-shadow: 6px 6px 0 #000; }

  /* ── riel de chips (viaje rápido + fallback accesible) ── */
  .mrmap__rail { display: flex; gap: 8px; overflow-x: auto; padding: 14px 2px 4px; scrollbar-width: none; }
  .mrmap__rail::-webkit-scrollbar { display: none; }
  .mrmap__chip {
    flex: none; font-family: var(--mono); font-size: 11px; font-weight: 700;
    text-transform: uppercase; letter-spacing: .07em; padding: 9px 15px;
    border: 2px solid var(--bd); border-radius: 999px; color: var(--mute);
    transition: color .14s ease, border-color .14s ease, background-color .14s ease;
  }
  .mrmap__chip:hover, .mrmap__chip:focus-visible { color: var(--ink); background: var(--chip, var(--mr)); border-color: var(--chip, var(--mr)); }
  .mrmap__chip.is-on { color: var(--ink); background: var(--chip, var(--mr)); border-color: var(--chip, var(--mr)); }

  .mrmap-sec :focus-visible { outline: 3px solid var(--zest); outline-offset: 2px; border-radius: 4px; }
  /* el mapa enfocado se marca por dentro: avisa que ya responde al teclado */
  .mrmap__stage:focus-visible { outline: 3px solid var(--zest); outline-offset: -3px; }

  @media (min-width: 750px) {
    .mrmap-sec { --pad: 40px; padding: 78px 0 84px; }
    .mrmap__stage { aspect-ratio: 16 / 9; max-height: 620px; }
    .mrmap-sub { font-size: 16px; }
    .mrmap__dlg { left: auto; right: 16px; bottom: 16px; width: min(460px, 46%); }
    .mrmap__dlgp { font-size: 14px; }
    .mrmap__tag { font-size: 11px; padding: 6px 11px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .mrmap__tag.is-near { animation: none; }
    .mrmap__dlg { animation: none; }
  }
</style>

<script>
(function () {
  var ROOT = document.getElementById('mrmap-{{ section.id }}');
  if (!ROOT || ROOT.dataset.ready) return;
  ROOT.dataset.ready = '1';

  var ZONES = [];
  try { ZONES = JSON.parse(ROOT.querySelector('.mrmap__data').textContent) || []; } catch (e) {}
  ZONES = ZONES.slice(0, 12);
  if (!ZONES.length) { ROOT.style.display = 'none'; return; }

  var stage  = ROOT.querySelector('.mrmap__stage');
  var cv     = ROOT.querySelector('.mrmap__cv');
  var ctx    = cv.getContext('2d');
  var tagBox = ROOT.querySelector('.mrmap__tags');
  var hint   = ROOT.querySelector('.mrmap__hint');
  var dlg    = ROOT.querySelector('.mrmap__dlg');
  var rail   = ROOT.querySelector('.mrmap__rail');
  var REDUCE = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ═══════════ paleta del mundo ═══════════ */
  var C = {
    ink:'#0F0B07', grass:'#4FA83E', grass2:'#5CBF49', grass3:'#3E8A32',
    path:'#E8C98F', path2:'#D9B478', path3:'#C79E63',
    wall:'#FFF8F2', wall2:'#E7DACD', stone:'#CFC3B6',
    wood:'#6B4A2A', wood2:'#4E3520',
    leaf:'#2F7A2C', leaf2:'#3F9438', leaf3:'#215C20',
    water:'#3FA9E8', water2:'#6EC6F2', zest:'#FFC400'
  };
  function px(g, x, y, w, h, c) { g.fillStyle = c; g.fillRect(x | 0, y | 0, w | 0, h | 0); }
  function rng(seed) { var s = seed >>> 0; return function () { s = (s * 1664525 + 1013904223) >>> 0; return s / 4294967296; }; }
  function shade(hex, k) {
    var n = parseInt(hex.replace('#', ''), 16);
    var r = Math.max(0, Math.min(255, ((n >> 16) & 255) * k)) | 0;
    var g = Math.max(0, Math.min(255, ((n >> 8) & 255) * k)) | 0;
    var b = Math.max(0, Math.min(255, (n & 255) * k)) | 0;
    return 'rgb(' + r + ',' + g + ',' + b + ')';
  }

  /* ═══════════ geometría del mundo ═══════════ */
  var TS = 16, BW = 7, BH = 6, GAP = 2, HT = 28;
  var per = Math.ceil(ZONES.length / 2);
  var WT  = Math.max(24, per * BW + (per - 1) * GAP + 12);

  var G_GRASS = 0, G_PATH = 1, G_SOLID = 2;
  var kind = new Uint8Array(WT * HT);
  function at(x, y) { return (x < 0 || y < 0 || x >= WT || y >= HT) ? G_SOLID : kind[y * WT + x]; }
  function put(x, y, v) { if (x >= 0 && y >= 0 && x < WT && y < HT) kind[y * WT + x] = v; }

  function slotOf(i) {
    var k = i % per;
    return { bx: 6 + k * (BW + GAP), by: (i < per) ? 4 : 16 };
  }
  for (var i = 0; i < ZONES.length; i++) {
    var s = slotOf(i);
    ZONES[i].bx = s.bx; ZONES[i].by = s.by;
    ZONES[i].dx = s.bx + 3; ZONES[i].dy = s.by + BH - 1;   /* tile de la puerta */
    ZONES[i].fx = s.bx + 3; ZONES[i].fy = s.by + BH;       /* tile de enfrente  */
  }

  /* caminos: dos avenidas horizontales + verticales a los costados + callejones */
  function road(x0, y0, x1, y1) {
    for (var y = y0; y <= y1; y++) for (var x = x0; x <= x1; x++) put(x, y, G_PATH);
  }
  road(3, 10, WT - 4, 11);
  road(3, 22, WT - 4, 23);
  road(3, 10, 4, 23);
  road(WT - 5, 10, WT - 4, 23);
  for (var k = 0; k < per - 1; k++) {
    var ax = 6 + k * (BW + GAP) + BW;
    road(ax, 10, ax, 23);
  }

  /* edificios y bosque del borde: sólidos */
  for (var z = 0; z < ZONES.length; z++) {
    for (var by = 0; by < BH; by++) for (var bx = 0; bx < BW; bx++) put(ZONES[z].bx + bx, ZONES[z].by + by, G_SOLID);
  }
  for (var y2 = 0; y2 < HT; y2++) for (var x2 = 0; x2 < WT; x2++) {
    if (x2 < 2 || x2 > WT - 3 || y2 < 2 || y2 > HT - 3) put(x2, y2, G_SOLID);
  }

  /* fuente en la plaza central, esquivando callejones */
  var fnt = null;
  for (var off = 0; off < WT && !fnt; off++) {
    for (var sgn = -1; sgn <= 1 && !fnt; sgn += 2) {
      var fx = (WT >> 1) + sgn * off;
      if (at(fx, 13) === G_GRASS && at(fx + 1, 13) === G_GRASS && at(fx, 14) === G_GRASS && at(fx + 1, 14) === G_GRASS) {
        fnt = { x: fx, y: 13 };
        put(fx, 13, G_SOLID); put(fx + 1, 13, G_SOLID); put(fx, 14, G_SOLID); put(fx + 1, 14, G_SOLID);
      }
    }
  }

  /* arbolado suelto en las franjas de pasto: da profundidad y marca los bordes */
  var decor = [];
  (function plantar() {
    var r0 = rng(77341), bandas = [2, 3, HT - 4, HT - 3];
    for (var i = 0; i < bandas.length; i++) {
      var y = bandas[i];
      for (var x = 3; x < WT - 3; x++) {
        if (at(x, y) !== G_GRASS) continue;
        var d = r0();
        if (d < 0.16) { decor.push({ x: x, y: y, t: 0 }); put(x, y, G_SOLID); }
        else if (d < 0.26) { decor.push({ x: x, y: y, t: 1 }); put(x, y, G_SOLID); }
      }
    }
  })();

  /* ═══════════ pintado del mundo (una sola vez) ═══════════ */
  var world = document.createElement('canvas');
  world.width = WT * TS; world.height = HT * TS;
  var wg = world.getContext('2d');
  var R = rng(20260820);

  function tGrass(g, ox, oy, r) {
    px(g, ox, oy, TS, TS, C.grass);
    for (var a = 0; a < 3; a++) px(g, ox + (r() * 15 | 0), oy + (r() * 15 | 0), 2, 1, C.grass2);
    for (var b = 0; b < 2; b++) px(g, ox + (r() * 15 | 0), oy + (r() * 14 | 0), 1, 2, C.grass3);
  }
  function tFlower(g, ox, oy, r) {
    var cols = [['#FF6BA9','#FFB3D4'], [C.zest,'#FFE47A'], ['#FFF8F2','#FFFFFF'], ['#C77DFF','#E2B8FF']];
    var c2 = cols[(r() * cols.length) | 0];
    var a = 3 + (r() * 10 | 0), b = 4 + (r() * 8 | 0);
    px(g, ox + a, oy + b + 2, 1, 3, C.leaf3);
    px(g, ox + a - 1, oy + b + 3, 1, 1, C.leaf2);
    px(g, ox + a - 1, oy + b, 3, 2, C.leaf3);
    px(g, ox + a - 1, oy + b, 3, 2, c2[0]);
    px(g, ox + a - 1, oy + b, 1, 1, c2[1]);
  }
  function tTuft(g, ox, oy, r) {
    var a = 2 + (r() * 11 | 0), b = 6 + (r() * 7 | 0);
    px(g, ox + a, oy + b, 1, 4, C.leaf3);
    px(g, ox + a + 2, oy + b + 1, 1, 3, C.grass3);
    px(g, ox + a - 2, oy + b + 2, 1, 2, C.grass3);
  }
